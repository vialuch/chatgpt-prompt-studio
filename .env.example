PORT=8787
DATA_FILE=./data/clips.json

# Notion adapter (optional — if not set, local JSON is used)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_database_id_here

# AI enrichment (optional — if not set, clips are saved without AI analysis)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Telegram bot (optional — configure in telegram/.env)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
CLIP_API_BASE=http://localhost:8787
